# Required in production. Generate with a cryptographically secure password manager.
JWT_SECRET="replace-with-a-long-random-secret"

# Optional first-run provisioning. Never commit real values; remove these after
# creating your administrator account.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeThisAdminPassword1"
SEED_STUDENT_EMAIL="student@example.com"
SEED_STUDENT_PASSWORD="ChangeThisStudentPassword1"

# Required to deliver real password-reset links through Resend. The app returns
# a configuration error rather than claiming an email was sent when these are absent.
APP_URL="http://localhost:3000"
RESEND_API_KEY="re_..."
EMAIL_FROM="MockMaster <no-reply@your-verified-domain.example>"
